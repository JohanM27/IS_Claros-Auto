generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMINISTRADOR
  RECEPCIONISTA
  MECANICO
}

model StaffProfile {
  userId                 String                    @id @db.Uuid
  role                   StaffRole
  displayName            String?                   @db.VarChar(150)
  createdAt              DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                  @updatedAt @db.Timestamptz(3)
  workOrderStatusChanges WorkOrderStatusHistory[]
  workOrderRecordChanges WorkOrderRecordHistory[]
  diagnosticosCreados    DiagnosticoOrden[]        @relation("DiagnosisCreatedBy")
  diagnosticosEditados   DiagnosticoOrden[]        @relation("DiagnosisUpdatedBy")
  diagnosticChanges      DiagnosticoOrdenHistory[]
  trabajosCreados        TrabajoRealizado[]        @relation("WorkTaskCreatedBy")
  trabajosEditados       TrabajoRealizado[]        @relation("WorkTaskUpdatedBy")
}

enum UnidadMedidaRepuesto {
  UNIDAD
  LITRO
  GALON
  MILILITRO
  METRO
  KILOGRAMO
  GRAMO
  JUEGO
  PAR
  CAJA
  BOTELLA
}

model CategoriaRepuesto {
  id                 String     @id @default(uuid()) @db.Uuid
  nombre             String     @db.VarChar(150)
  nombreNormalizado  String     @unique @db.VarChar(150)
  descripcion        String?    @db.VarChar(1000)
  activo             Boolean    @default(true)
  fechaCreacion      DateTime   @default(now()) @db.Timestamptz(3)
  fechaActualizacion DateTime   @updatedAt @db.Timestamptz(3)
  repuestos          Repuesto[]

  @@index([activo, nombre])
}

model Repuesto {
  id                 String               @id @default(uuid()) @db.Uuid
  sku                String               @unique @db.VarChar(20)
  codigoBarras       String?              @unique @db.VarChar(80)
  nombre             String               @db.VarChar(180)
  descripcion        String?              @db.VarChar(2000)
  categoriaId        String               @db.Uuid
  marca              String?              @db.VarChar(100)
  numeroParte        String?              @db.VarChar(100)
  unidadMedida       UnidadMedidaRepuesto @default(UNIDAD)
  precioCompra       Decimal              @db.Decimal(12, 2)
  precioVenta        Decimal              @db.Decimal(12, 2)
  stockActual        Decimal              @default(0) @db.Decimal(12, 3)
  stockMinimo        Decimal              @default(0) @db.Decimal(12, 3)
  activo             Boolean              @default(true)
  fechaCreacion      DateTime             @default(now()) @db.Timestamptz(3)
  fechaActualizacion DateTime             @updatedAt @db.Timestamptz(3)
  categoria          CategoriaRepuesto    @relation(fields: [categoriaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([categoriaId, activo])
  @@index([activo, nombre])
}

model Service {
  id           String        @id @default(cuid())
  slug         String        @unique @db.VarChar(80)
  name         String        @db.VarChar(120)
  description  String        @db.VarChar(500)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  appointments Appointment[]

  @@index([isActive])
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

enum WorkOrderStatus {
  ABIERTA
  EN_DIAGNOSTICO
  EN_PROCESO
  FINALIZADA
  CANCELADA
}

model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(150)
  phone        String        @db.VarChar(30)
  email        String?       @db.VarChar(254)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  vehicles     Vehicle[]
  appointments Appointment[]
  workOrders   WorkOrder[]

  @@index([phone])
}

model Vehicle {
  id           String        @id @default(uuid()) @db.Uuid
  customerId   String        @db.Uuid
  make         String        @db.VarChar(80)
  model        String        @db.VarChar(100)
  year         Int           @db.SmallInt
  plate        String?       @db.VarChar(20)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointments Appointment[]
  workOrders   WorkOrder[]

  @@index([customerId])
  @@index([plate])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @db.Uuid
  vehicleId       String            @db.Uuid
  serviceId       String
  requestedAt     DateTime          @db.Timestamptz(3)
  notes           String?           @db.VarChar(1000)
  status          AppointmentStatus @default(PENDIENTE)
  lookupTokenHash String            @db.Char(64)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workOrder       WorkOrder?

  @@index([customerId])
  @@index([vehicleId])
  @@index([serviceId])
  @@index([status, requestedAt])
}

model WorkOrder {
  id                  String                   @id @default(uuid()) @db.Uuid
  numeroOrden         String                   @unique @db.VarChar(30)
  clienteId           String                   @db.Uuid
  vehiculoId          String                   @db.Uuid
  citaId              String?                  @unique @db.Uuid
  descripcionProblema String                   @db.VarChar(2000)
  observaciones       String?                  @db.VarChar(2000)
  mecanicoResponsable String?                  @db.VarChar(150)
  kilometraje         Int?
  idempotencyKey      String                   @unique @db.Uuid
  requestHash         String                   @db.Char(64)
  estado              WorkOrderStatus          @default(ABIERTA)
  fechaIngreso        DateTime                 @default(now()) @db.Timestamptz(3)
  fechaCreacion       DateTime                 @default(now()) @db.Timestamptz(3)
  fechaActualizacion  DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  cliente             Customer                 @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehiculo            Vehicle                  @relation(fields: [vehiculoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cita                Appointment?             @relation(fields: [citaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  historialEstados    WorkOrderStatusHistory[]
  diagnostico         DiagnosticoOrden?
  trabajos            TrabajoRealizado[]
  historialRegistros  WorkOrderRecordHistory[]

  @@index([clienteId, fechaIngreso])
  @@index([vehiculoId])
  @@index([estado, fechaIngreso])
}

model WorkOrderStatusHistory {
  id             String          @id @default(uuid()) @db.Uuid
  ordenTrabajoId String          @db.Uuid
  estadoAnterior WorkOrderStatus
  estadoNuevo    WorkOrderStatus
  observaciones  String?         @db.VarChar(2000)
  usuarioId      String          @db.Uuid
  fechaCambio    DateTime        @default(now()) @db.Timestamptz(3)
  ordenTrabajo   WorkOrder       @relation(fields: [ordenTrabajoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario        StaffProfile    @relation(fields: [usuarioId], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([ordenTrabajoId, fechaCambio])
  @@index([usuarioId])
}

enum WorkOrderRecordType {
  DIAGNOSTICO
  TRABAJO
}

enum WorkOrderRecordAction {
  CREADO
  ACTUALIZADO
  RETIRADO
}

model DiagnosticoOrden {
  id                     String                    @id @default(uuid()) @db.Uuid
  ordenTrabajoId         String                    @unique @db.Uuid
  diagnostico            String                    @db.VarChar(4000)
  causaIdentificada      String?                   @db.VarChar(2000)
  recomendaciones        String?                   @db.VarChar(2000)
  observaciones          String?                   @db.VarChar(2000)
  usuarioRegistroId      String                    @db.Uuid
  usuarioActualizacionId String                    @db.Uuid
  fechaDiagnostico       DateTime                  @default(now()) @db.Timestamptz(3)
  fechaCreacion          DateTime                  @default(now()) @db.Timestamptz(3)
  fechaActualizacion     DateTime                  @updatedAt @db.Timestamptz(3)
  ordenTrabajo           WorkOrder                 @relation(fields: [ordenTrabajoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioRegistro        StaffProfile              @relation("DiagnosisCreatedBy", fields: [usuarioRegistroId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  usuarioActualizacion   StaffProfile              @relation("DiagnosisUpdatedBy", fields: [usuarioActualizacionId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  historial              DiagnosticoOrdenHistory[]

  @@index([usuarioRegistroId])
  @@index([usuarioActualizacionId])
}

model DiagnosticoOrdenHistory {
  id                 String           @id @default(uuid()) @db.Uuid
  diagnosticoOrdenId String           @db.Uuid
  diagnostico        String           @db.VarChar(4000)
  causaIdentificada  String?          @db.VarChar(2000)
  recomendaciones    String?          @db.VarChar(2000)
  observaciones      String?          @db.VarChar(2000)
  usuarioId          String           @db.Uuid
  fechaCambio        DateTime         @default(now()) @db.Timestamptz(3)
  diagnosticoOrden   DiagnosticoOrden @relation(fields: [diagnosticoOrdenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario            StaffProfile     @relation(fields: [usuarioId], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([diagnosticoOrdenId, fechaCambio])
}

model TrabajoRealizado {
  id                     String       @id @default(uuid()) @db.Uuid
  ordenTrabajoId         String       @db.Uuid
  nombre                 String       @db.VarChar(150)
  descripcion            String?      @db.VarChar(2000)
  cantidad               Decimal      @db.Decimal(10, 2)
  precioUnitario         Decimal      @db.Decimal(12, 2)
  mecanicoResponsable    String?      @db.VarChar(150)
  usuarioRegistroId      String       @db.Uuid
  usuarioActualizacionId String       @db.Uuid
  idempotencyKey         String       @unique @db.Uuid
  requestHash            String       @db.Char(64)
  activo                 Boolean      @default(true)
  fechaRetiro            DateTime?    @db.Timestamptz(3)
  fechaCreacion          DateTime     @default(now()) @db.Timestamptz(3)
  fechaActualizacion     DateTime     @updatedAt @db.Timestamptz(3)
  ordenTrabajo           WorkOrder    @relation(fields: [ordenTrabajoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioRegistro        StaffProfile @relation("WorkTaskCreatedBy", fields: [usuarioRegistroId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  usuarioActualizacion   StaffProfile @relation("WorkTaskUpdatedBy", fields: [usuarioActualizacionId], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([ordenTrabajoId, activo, fechaCreacion])
  @@index([usuarioRegistroId])
  @@index([usuarioActualizacionId])
}

model WorkOrderRecordHistory {
  id             String                @id @default(uuid()) @db.Uuid
  ordenTrabajoId String                @db.Uuid
  tipo           WorkOrderRecordType
  accion         WorkOrderRecordAction
  registroId     String                @db.Uuid
  usuarioId      String                @db.Uuid
  snapshot       Json
  fechaCambio    DateTime              @default(now()) @db.Timestamptz(3)
  ordenTrabajo   WorkOrder             @relation(fields: [ordenTrabajoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario        StaffProfile          @relation(fields: [usuarioId], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([ordenTrabajoId, fechaCambio])
  @@index([tipo, registroId])
}
