generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMINISTRADOR
  RECEPCIONISTA
  MECANICO
}

model StaffProfile {
  userId      String    @id @db.Uuid
  role        StaffRole
  displayName String?   @db.VarChar(150)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
}

model Service {
  id           String        @id @default(cuid())
  slug         String        @unique @db.VarChar(80)
  name         String        @db.VarChar(120)
  description  String        @db.VarChar(500)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  appointments Appointment[]

  @@index([isActive])
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

enum WorkOrderStatus {
  ABIERTA
  EN_DIAGNOSTICO
  EN_PROCESO
  FINALIZADA
  CANCELADA
}

model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(150)
  phone        String        @db.VarChar(30)
  email        String?       @db.VarChar(254)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  vehicles     Vehicle[]
  appointments Appointment[]
  workOrders   WorkOrder[]

  @@index([phone])
}

model Vehicle {
  id           String        @id @default(uuid()) @db.Uuid
  customerId   String        @db.Uuid
  make         String        @db.VarChar(80)
  model        String        @db.VarChar(100)
  year         Int           @db.SmallInt
  plate        String?       @db.VarChar(20)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointments Appointment[]
  workOrders   WorkOrder[]

  @@index([customerId])
  @@index([plate])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @db.Uuid
  vehicleId       String            @db.Uuid
  serviceId       String
  requestedAt     DateTime          @db.Timestamptz(3)
  notes           String?           @db.VarChar(1000)
  status          AppointmentStatus @default(PENDIENTE)
  lookupTokenHash String            @db.Char(64)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workOrder       WorkOrder?

  @@index([customerId])
  @@index([vehicleId])
  @@index([serviceId])
  @@index([status, requestedAt])
}

model WorkOrder {
  id                  String          @id @default(uuid()) @db.Uuid
  numeroOrden         String          @unique @db.VarChar(30)
  clienteId           String          @db.Uuid
  vehiculoId          String          @db.Uuid
  citaId              String?         @unique @db.Uuid
  descripcionProblema String          @db.VarChar(2000)
  observaciones       String?         @db.VarChar(2000)
  mecanicoResponsable String?         @db.VarChar(150)
  estado              WorkOrderStatus @default(ABIERTA)
  fechaIngreso        DateTime        @default(now()) @db.Timestamptz(3)
  fechaCreacion       DateTime        @default(now()) @db.Timestamptz(3)
  fechaActualizacion  DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  cliente             Customer        @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehiculo            Vehicle         @relation(fields: [vehiculoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cita                Appointment?    @relation(fields: [citaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([clienteId, fechaIngreso])
  @@index([vehiculoId])
  @@index([estado, fechaIngreso])
}
