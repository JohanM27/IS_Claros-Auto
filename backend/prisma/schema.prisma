generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id           String        @id @default(cuid())
  slug         String        @unique @db.VarChar(80)
  name         String        @db.VarChar(120)
  description  String        @db.VarChar(500)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  appointments Appointment[]

  @@index([isActive])
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(150)
  phone        String        @db.VarChar(30)
  email        String?       @db.VarChar(254)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  vehicles     Vehicle[]
  appointments Appointment[]

  @@index([phone])
}

model Vehicle {
  id           String        @id @default(uuid()) @db.Uuid
  customerId   String        @db.Uuid
  make         String        @db.VarChar(80)
  model        String        @db.VarChar(100)
  year         Int           @db.SmallInt
  plate        String?       @db.VarChar(20)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointments Appointment[]

  @@index([customerId])
  @@index([plate])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @db.Uuid
  vehicleId       String            @db.Uuid
  serviceId       String
  requestedAt     DateTime          @db.Timestamptz(3)
  notes           String?           @db.VarChar(1000)
  status          AppointmentStatus @default(PENDIENTE)
  lookupTokenHash String            @db.Char(64)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([customerId])
  @@index([vehicleId])
  @@index([serviceId])
  @@index([status, requestedAt])
}
